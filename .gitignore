# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]

# ---- Environments ---------------------------------------------------------
.venv/
.env
.env.*
!.env.example

# ---- Tooling caches -------------------------------------------------------
.ruff_cache/
.ipynb_checkpoints/

# ---- marimo ---------------------------------------------------------------
__marimo__/
.marimo.toml.lock
marimo.log

# ---- R --------------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/

# ---- Data (keep the tree, not the payload) --------------------------------
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep
outputs/*
!outputs/.gitkeep

# ---- Agent / editor local state -------------------------------------------
.pi/sessions/
.pi/settings.local.json
.claude/settings.local.json
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
