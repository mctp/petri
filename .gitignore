# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]

# ---- Environments ---------------------------------------------------------
.venv/
.env
.env.*
!.env.example

# ---- Tooling caches -------------------------------------------------------
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# ---- marimo ---------------------------------------------------------------
# Project settings live in [tool.marimo] in pyproject.toml, which marimo only
# ever reads. There is no tracked .marimo.toml for it to rewrite; a stray one
# would shadow that section, so keep it ignored rather than committed.
__marimo__/
.marimo.toml
.marimo.toml.lock
marimo.log

# ---- R --------------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/

# ---- Data (keep the tree and the provenance, not the payload) --------------
# The four data directories live under data/. Each is named for the API verb
# that writes it.
# data/external/   load_external()  — unowned; never versioned, fingerprinted
# data/shared/     save_shared()    — interface layer; bytes ignored, manifests
#                                     kept
# data/cache/      persistent_cache — disposable
#
# These govern the user's workspace. The directories ship holding nothing but a
# .gitkeep, and `make init` fills them, but what the user then writes there is
# theirs to version: a manifest is committed so a collaborator can verify a table
# they cannot download.
data/external/*
data/cache/*
data/shared/*
!data/shared/*.manifest.json
!data/external/.gitkeep
!data/cache/.gitkeep
!data/shared/.gitkeep

# ---- data/preserved/ (terminal deliverables — tracked wholesale) -----------
# preserve_figure() / preserve_table() / preserve_file(). Bundles are small by
# construction: source-data.csv is what was plotted, not the matrix behind it.
# Nothing here is ignored.

# ---- petri/examples/ (the template's payload — tracked wholesale) ----------
# What `make init` copies out has to be in git, so the rules above must not reach
# it. They are all anchored to the repo root by their slashes and do not, but say
# so explicitly rather than relying on that. The shared CSVs are tracked here
# although the working copies are not: `make init full` has to land a table beside
# every manifest it installs, or `check()` reports the output missing.
!petri/examples/**

# ---- Agent / editor local state -------------------------------------------
.pi/sessions/
.pi/settings.local.json
.claude/settings.local.json
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
