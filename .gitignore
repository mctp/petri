# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]

# ---- Environments ---------------------------------------------------------
.venv/
.env
.env.*
!.env.example

# ---- Tooling caches -------------------------------------------------------
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# ---- marimo ---------------------------------------------------------------
# Project settings live in [tool.marimo] in pyproject.toml, which marimo only
# ever reads. There is no tracked .marimo.toml for it to rewrite; a stray one
# would shadow that section, so keep it ignored rather than committed.
__marimo__/
.marimo.toml
.marimo.toml.lock
marimo.log

# ---- R --------------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/

# ---- Data (the user's workspace — the tree is tracked, nothing in it) ------
# All four directories are ignored, manifests included. `data/` holds what the
# person using this template is working on: inputs they were given, tables they
# published, deliverables they rendered, and scratch. None of it is the
# template's to version, and a manifest is a generated file like any other.
#
# So provenance is verified where the data is, by `make check`, and not shipped
# through git. Commit a manifest deliberately if a collaborator needs to verify a
# table they cannot download — `git add -f data/shared/<name>.manifest.json`.
#
# The directories themselves are tracked, as a .gitkeep each, so a fresh clone
# has somewhere for `make init` to write.
data/external/*
data/shared/*
data/preserved/*
data/cache/*
!data/*/.gitkeep

# ---- Notebooks and transformations (the user's workspace) ------------------
# Same reasoning as `data/` above. `notebooks/` and `scripts/` hold what the
# person using this template writes, and `make init` fills them from
# `petri/examples/`. Since the template ships them empty, a file that appears
# here is installed output, not source — committing one would ship a second,
# drifting copy of an example. A change to an example belongs in the tracked
# original under `petri/examples/`.
#
# As with `data/`, the directories themselves stay tracked via a .gitkeep each.
notebooks/*
scripts/*
!notebooks/.gitkeep
!scripts/.gitkeep

# ---- petri/examples/ (the template's payload — tracked wholesale) ----------
# What `make init` copies out has to be in git, so the rules above must not reach
# it. They are all anchored to the repo root by their slashes and do not, but say
# so explicitly rather than relying on that. The shared CSVs are tracked here
# although the working copies are not: `make init full` has to land a table beside
# every manifest it installs, or `check()` reports the output missing.
!petri/examples/**

# ---- Agent / editor local state -------------------------------------------
.pi/sessions/
.pi/settings.local.json
.claude/settings.local.json
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
