# Copy to .env and fill in. .env is gitignored.
# marimo loads .env automatically on startup if pyproject.toml is present.

# Add project root to Python module search path
PYTHONPATH=.

# --- marimo ---------------------------------------------------------------
# Token for authenticated marimo servers (the marimo-pair skill reads this).
# MARIMO_TOKEN=

# --- R / rpy2 -------------------------------------------------------------
# r_bridge defaults this to ABI, which loads any R. Set API to opt into the
# compiled interface when the rpy2 wheel matches your R (petri/docs/rpy2.md).
RPY2_CFFI_MODE=ABI
# R_HOME=$(R RHOME)

# --- data sources ---------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@localhost:5432/db
# S3_BUCKET=my-bucket
