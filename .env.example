# Copy to .env and fill in. .env is gitignored.
# Loaded by marimo/pi only if you export it, e.g. `set -a; . ./.env; set +a`

# Example: credentials for data sources
# DATABASE_URL=postgresql://user:pass@localhost:5432/db
# S3_BUCKET=my-bucket

# marimo: token for authenticated servers (see marimo-pair skill)
# MARIMO_TOKEN=
